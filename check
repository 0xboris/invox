#!/usr/bin/env bash
# The one command that verifies the project. Agents run it after every step.
# It prints only failures; full logs go to .check/ .
set -uo pipefail
cd "$(dirname "$0")"
mkdir -p .check
status=0

step() {
  local name="$1"; shift
  if "$@" > ".check/$name.log" 2>&1; then
    echo "ok    $name"
  else
    echo "FAIL  $name   (full log: .check/$name.log)"
    head -60 ".check/$name.log"
    status=1
  fi
}

gofmt_clean() {
  local unformatted
  unformatted=$(gofmt -l .)
  [ -z "$unformatted" ] || { echo "Run gofmt -w on:"; echo "$unformatted"; return 1; }
}

module_map_current() {
  python3 tools/archcheck.py --module-map .check/modules.md &&
    diff -u docs/architecture/modules.md .check/modules.md ||
    { echo "Run: python3 tools/archcheck.py --module-map docs/architecture/modules.md"; return 1; }
}

step architecture python3 tools/archcheck.py
step module-map module_map_current
step format gofmt_clean
step tidy go mod tidy -diff
step vet go vet ./...
step build go build ./...
step test go test -race -shuffle=on -timeout=10m ./...

exit $status
