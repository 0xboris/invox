// The module map and the import rules that tools/archcheck.py enforces.
// docs/ARCHITECTURE.md explains the kinds, and docs/architecture/go.md says
// where each invox package sits today. This is a gate file: change it on
// purpose, in its own commit, with the owner's approval.
{
  "language": "go",
  "sourceRoots": ["."],
  "testFiles": ["**/*_test.go"],
  "ignore": [],
  "glossary": "GLOSSARY.md",

  "modules": [
    {"path": "cmd/*", "kind": "composition", "name": "cmd/{1}"},
    {"path": "internal/app", "kind": "composition", "name": "app"},
    {"path": "internal/docs/gen", "kind": "tool", "name": "docs/gen"},
    {"path": "internal/domain", "kind": "domain", "name": "domain"},
    {"path": "internal/features/*/usecases", "kind": "usecases", "name": "{1}/usecases", "slice": "{1}"},
    {"path": "internal/features/*/ui", "kind": "ui", "name": "{1}/ui", "slice": "{1}"},
    {"path": "internal/sharedui", "kind": "shared-ui", "name": "sharedui"},
    {"path": "internal/adapters/*", "kind": "adapter", "name": "adapters/{1}"},
    {"path": "internal/utilities", "kind": "utilities", "name": "utilities"},
    {"path": "internal/testsupport", "kind": "test-support", "name": "testsupport"}
  ],

  "kinds": {
    "domain": {
      "mayImport": ["utilities"],
      "external": {"allow": ["std", "gopkg.in/yaml.v3"], "deny": ["@io-packages"]},
      "forbiddenCalls": ["@io"]
    },
    "usecases": {
      "mayImport": ["domain", "utilities"],
      "external": {"allow": ["std"], "deny": ["@io-packages"]},
      "forbiddenCalls": ["@io"]
    },
    "ui": {
      "mayImport": ["usecases@same-slice", "domain", "shared-ui", "utilities"],
      "external": {"allow": ["std", "@cli-framework"], "deny": ["os", "os/*", "database/*", "math/rand", "math/rand/*", "crypto/rand", "syscall"]},
      "forbiddenCalls": ["@io", "@http-client"]
    },
    "shared-ui": {
      "mayImport": ["utilities"],
      "external": {"allow": ["std", "@cli-framework"], "deny": ["os", "os/*", "database/*", "math/rand", "math/rand/*", "crypto/rand", "syscall"]},
      "forbiddenCalls": ["@io", "@http-client"],
      "bannedTerms": "glossary"
    },
    "adapter": {
      "mayImport": ["domain", "utilities"],
      "external": {"allow": ["*"]}
    },
    "composition": {
      "mayImport": ["domain", "usecases", "ui", "shared-ui", "adapter", "composition", "utilities"],
      "external": {"allow": ["std", "@cli-framework"]},
      "composition": {
        "allowedFiles": ["main.go", "app.go", "config.go", "live.go", "wire_*.go"],
        "controlFlowAllowedIn": ["config.go"],
        "controlFlowAllowedPatterns": ["^\\s*if err != nil \\{", "^\\s*if err := .*; err != nil \\{"],
        "maxLines": 400
      }
    },
    // A development program, such as the docs generator. It may use the whole
    // project, and the release binary may not import it: no other kind lists
    // "tool" in mayImport.
    "tool": {
      "mayImport": ["domain", "usecases", "ui", "shared-ui", "adapter", "composition", "utilities"],
      "external": {"allow": ["*"]}
    },
    "utilities": {
      "mayImport": [],
      "external": {"allow": ["std"], "deny": ["@io-packages"]},
      "forbiddenCalls": ["@io"],
      "bannedTerms": "glossary"
    },
    "test-support": {
      "mayImport": ["domain", "utilities"],
      "external": {"allow": ["std"]}
    }
  },

  "externalSets": {
    // io/fs holds only interfaces, types and errors, which the domain's ports
    // use; net/mail and net/textproto only parse and format messages.
    "io-packages": ["net", "net/http", "net/http/*", "net/rpc", "net/rpc/*", "net/smtp", "os", "os/*", "io/ioutil",
                    "database/*", "math/rand", "math/rand/*", "crypto/rand", "syscall", "log", "log/*", "embed",
                    "runtime/debug", "plugin"],
    "cli-framework": ["github.com/spf13/cobra", "github.com/spf13/cobra/*", "github.com/spf13/pflag"]
  },

  "forbiddenCallSets": {
    "io": [
      {"pattern": "\\btime\\.(Now|Since|Until|Sleep|After|AfterFunc|Tick|NewTicker|NewTimer)\\(", "fix": "Take the time from env.Env.Now, which the caller passes in."},
      {"pattern": "\\bfmt\\.Print(f|ln)?\\(", "fix": "Write to the injected IOStreams, or return the data and let the command print it."}
    ],
    "http-client": [
      {"pattern": "\\bhttp\\.(Get|Post|PostForm|Head|NewRequest|NewRequestWithContext|DefaultClient)\\b",
       "fix": "Outgoing requests are I/O. Declare a port in the domain and implement it in an adapter."}
    ]
  }
}
