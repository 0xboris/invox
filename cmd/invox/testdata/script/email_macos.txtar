# On macOS, email without -o opens a compose window in Apple Mail through
# osascript. The fake osascript prints the recipient, subject and attachment.
[!darwin] skip 'Apple Mail is only used on macOS'

exec invox email invoice.yaml
cmp stdout want-email.txt
! stderr .
! exists invoice.eml

-- invoice.pdf --
-- want-email.txt --
fake osascript: to=office@appsters.example subject="Invoice CUST-001-001" attachment=invoice.pdf
Opened email draft for CUST-001 (CUST-001-001) to office@appsters.example
-- home/.config/invox/config.yaml --
archive:
  dir: archive
-- home/.config/invox/customers.yaml --
CUST-001:
  name: Appsters GmbH
  status: active
  email: office@appsters.example
  email_greeting: Dear Jane Doe,
  contact_person: Jane Doe
  address:
    street: Hauptstrasse 1
    postal_code: "1010"
    city: Vienna
    country: Austria
  tax:
    vat_tax_id: ATU12345678
  billing:
    currency: EUR
CUST-002:
  name: Second Customer OG
  status: inactive
  email: billing@second.example
  address:
    street: Nebenstrasse 2
    postal_code: "8010"
    city: Graz
    country: Austria
CUST-003:
  name: Third Customer KG
  status: active
  email: billing@third.example
  address:
    street: Seeweg 3
    postal_code: "5020"
    city: Salzburg
    country: Austria
-- home/.config/invox/issuer.yaml --
company:
  legal_company_name: Boris Consulting
  company_registration_number: FN 123456a
  vat_tax_id: ATU87654321
  website: https://example.com
  email: hello@example.com
  address:
    street: Ring 1
    postal_code: "1010"
    city: Vienna
    country: Austria
payment:
  bank_name: Test Bank
  iban: AT611904300234573201
  bic: BKAUATWW
  due_days: 30
  payment_terms_text: Pay within 30 days
-- home/.config/invox/invoice_defaults.yaml --
invoice:
  period: "Leistungszeitraum: "
  vat_percent: 20
  paid_amount: 0
positions:
  - name: Example position
    description: Description of the delivered service
    unit_price: 100
    quantity: 1
-- home/.config/invox/template.tex --
Invoice @@INVOICE_NUMBER@@ for @@CUSTOMER_NAME@@
Issued @@ISSUE_DATE@@, due @@DUE_DATE@@
@@LINE_ITEMS_ROWS@@
Subtotal @@SUBTOTAL@@
@@VAT_SUMMARY_ROWS@@
Total @@TOTAL@@
Outstanding @@OUTSTANDING_AMOUNT@@
@@PAYMENT_TERMS_TEXT@@
IBAN @@IBAN@@
-- invoice.yaml --
customer_id: CUST-001
invoice:
  number: CUST-001-001
  issue_date: 2026-03-06
  due_date: 2026-04-05
  status: built
  period: "Leistungszeitraum: März 2026"
  vat_percent: 20
  paid_amount: 0
positions:
  - name: Development
    description: Sprint work
    unit_price: 100
    quantity: 2
  - name: Support
    description: QA
    unit_price: 10
    quantity: 1
