# An unknown subcommand suggests the closest ones, each quoted on its own.
exits 2 invox nit
! stdout .
cmp stderr want-root.txt

exits 2 invox customer lsit
! stdout .
cmp stderr want-customer.txt

# One candidate.
exits 2 invox template lsit
! stdout .
cmp stderr want-template.txt

