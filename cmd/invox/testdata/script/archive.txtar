# archive moves a built invoice into archive.dir and marks it archived;
# archive list and archive edit read it back. archive.dir is set in
# config.yaml (relative to it) so the paths are the same on every OS.
#
# Archiving a number that is already archived under another file is refused.

# Nothing archived yet.
exec invox archive list
! stdout .
! stderr .

# build --archive --dry-run shows the build and the move and changes nothing.
exec invox build invoice.yaml --archive --dry-run
scrubpaths stdout got.txt
cmp got.txt want-build-archive-stdout.txt
scrubpaths stderr got.txt
cmp got.txt want-build-archive-dry-run.txt
exists invoice.yaml
! exists invoice.pdf
! exists home/.config/invox/archive

# build --archive builds and archives in one go.
exec invox build invoice.yaml --archive
scrubpaths stdout got.txt
cmp got.txt want-build-archive-stdout.txt
scrubpaths stderr got.txt
cmp got.txt want-build-archive.txt
! exists invoice.yaml
grep '^  status: archived$' home/.config/invox/archive/invoice.yaml

# archive add on its own.
exec invox archive add second.yaml -n
scrubpaths stdout got.txt
cmp got.txt want-archive-stdout.txt
scrubpaths stderr got.txt
cmp got.txt want-archive-dry-run.txt
exists second.yaml
exec invox archive add second.yaml
scrubpaths stdout got.txt
cmp got.txt want-archive-stdout.txt
scrubpaths stderr got.txt
cmp got.txt want-archive.txt
! exists second.yaml

# archive list prints FILENAME<TAB>CUSTOMER_ID<TAB>ISSUE_DATE<TAB>STATUS.
# A Markdown invoice is no longer read: one warning names it, and archive
# edit refuses it.
cp legacy.md home/.config/invox/archive/legacy.md
exec invox archive list
cmp stdout want-list.tsv
scrubpaths stderr got.txt
cmp got.txt want-markdown-warning.txt
exits 1 invox archive edit legacy.md
! stdout .
scrubpaths stderr got.txt
cmp got.txt want-edit-markdown.txt
rm home/.config/invox/archive/legacy.md

# archive edit copies an archived invoice back for editing; archiving the
# working copy replaces the archived one. stdin is not a terminal here, so
# replacing needs --yes: without it, archive add exits 2 and changes nothing.
exec invox archive edit invoice.yaml
scrubpaths stdout got.txt
cmp got.txt want-edit-stdout.txt
scrubpaths stderr got.txt
cmp got.txt want-edit.txt
grep '^  status: editing$' invoice.yaml
cp home/.config/invox/archive/invoice.yaml archived-before.yaml
exits 2 invox archive add -i invoice.yaml
! stdout .
stderr '^error: archiving invoice\.yaml replaces archived invoice .*; pass --yes to replace it \(stdin is not a terminal\)$'
cmp home/.config/invox/archive/invoice.yaml archived-before.yaml
! exists home/.config/invox/archive/.history
exists invoice.yaml

# With --yes the working copy replaces the archived invoice, and the previous
# version is kept in archive/.history, which archive list ignores.
exec invox archive add -i invoice.yaml --yes
scrubpaths stdout got.txt
cmp got.txt want-rearchive.txt
stderr '^Archived invoice\.yaml -> .*archive[/\\]invoice\.yaml$'
stderr '^Replaced archived invoice .*archive[/\\]invoice\.yaml; previous version kept at .*archive[/\\]\.history[/\\]invoice\.\d{8}T\d{6}Z\.yaml$'
! exists invoice.yaml
exists home/.config/invox/archive/.history
exec invox archive list
cmp stdout want-list.tsv
! stderr .

# new --from-last starts from the newest archived invoice of the customer and
# continues its numbering.
exec invox new CUST-001 --from-last
cmp stdout want-from-last-stdout.txt
cmp stderr want-from-last.txt
grep '^  status: draft$' CUST-001-010.yaml
grep '^  - name: Development$' CUST-001-010.yaml

# Usage errors.
exits 2 invox archive add
! stdout .
cmp stderr want-missing-input.txt
exits 2 invox archive add a.yaml b.yaml
! stdout .
stderr '^error: unexpected arguments: b\.yaml$'
exits 2 invox archive edit
! stdout .
cmp stderr want-edit-missing.txt
exits 2 invox archive list extra
! stdout .
stderr '^error: unexpected arguments: extra$'

# Runtime errors.
exits 1 invox archive add draft.yaml
! stdout .
scrubpaths stderr got.txt
cmp got.txt want-not-built.txt
exists draft.yaml
exits 1 invox archive add duplicate.yaml
! stdout .
scrubpaths stderr got.txt
cmp got.txt want-duplicate.txt
exists duplicate.yaml
! exists home/.config/invox/archive/duplicate.yaml
exits 1 invox archive edit nosuch.yaml
! stdout .
stderr 'nosuch\.yaml'
exec invox archive edit second.yaml
exits 1 invox archive edit second.yaml
! stdout .
scrubpaths stderr got.txt
cmp got.txt want-edit-exists.txt
rm second.yaml
mkdir second.yaml
exits 1 invox archive edit second.yaml --force
! stdout .
scrubpaths stderr got.txt
cmp got.txt want-edit-dir.txt
exits 1 invox archive edit second.yaml --force -n
! stdout .
scrubpaths stderr got.txt
cmp got.txt want-edit-dir.txt
rm second.yaml
cp archive-file.yaml home/.config/invox/config.yaml
exits 1 invox archive list
! stdout .
scrubpaths stderr got.txt
cmp got.txt want-not-a-dir.txt

-- home/.config/invox/not-a-dir --
a file where archive.dir expects a directory
-- archive-file.yaml --
archive:
  dir: not-a-dir
-- second.yaml --
customer_id: CUST-003
invoice:
  number: CUST-003-001
  issue_date: 2026-03-07
  due_date: 2026-04-06
  status: built
  period: March
  vat_percent: 20
positions:
  - name: Consulting
    description: Workshop
    unit_price: 500
    quantity: 1
-- duplicate.yaml --
customer_id: CUST-003
invoice:
  number: CUST-003-001
  issue_date: 2026-03-08
  due_date: 2026-04-07
  status: built
  period: March
  vat_percent: 20
positions:
  - name: Consulting
    description: Workshop
    unit_price: 500
    quantity: 1
-- legacy.md --
---
customer_id: CUST-MD
invoice:
  number: CUST-MD-001
  issue_date: 2026-03-05
---
# Archived invoice
-- want-build-archive.txt --
fake tectonic: compiling invoice.tex
Built invoice.pdf for CUST-001 (CUST-001-001)
Archived invoice.yaml -> home/.config/invox/archive/invoice.yaml
-- want-build-archive-dry-run.txt --
Would build invoice.pdf for CUST-001 (CUST-001-001)
Would set invoice.status to built in invoice.yaml
Would archive invoice.yaml -> home/.config/invox/archive/invoice.yaml
-- want-archive-dry-run.txt --
Would archive second.yaml -> home/.config/invox/archive/second.yaml
-- want-archive.txt --
Archived second.yaml -> home/.config/invox/archive/second.yaml
-- want-markdown-warning.txt --
warning: 1 Markdown invoice in home/.config/invox/archive is no longer read; convert it to .yaml to include it:
  home/.config/invox/archive/legacy.md
-- want-edit-markdown.txt --
error: home/.config/invox/archive/legacy.md is a Markdown invoice, which invox no longer reads; convert it to .yaml
-- want-list.tsv --
invoice.yaml	CUST-001	2026-03-06	archived
second.yaml	CUST-003	2026-03-07	archived
-- want-edit.txt --
Editing home/.config/invox/archive/invoice.yaml -> invoice.yaml
-- want-rearchive.txt --
home/.config/invox/archive/invoice.yaml
-- want-from-last.txt --
Created CUST-001-010.yaml for CUST-001 (CUST-001-010)
-- want-missing-input.txt --
error: missing required input: INVOICE.yaml or -i, --input
Run 'invox archive add --help' for usage.
-- want-edit-missing.txt --
error: missing required arguments: FILENAME
Run 'invox archive edit --help' for usage.
-- want-duplicate.txt --
error: duplicate.yaml: invoice number CUST-003-001 is already used by archived invoice home/.config/invox/archive/second.yaml
Run 'invox increment -i duplicate.yaml' to give it the next free number, then archive it again.
-- want-not-built.txt --
error: draft.yaml: invoice.status must be `built` before archiving, got `draft`
-- want-edit-dir.txt --
error: second.yaml is a directory; choose a different working directory
-- want-edit-exists.txt --
error: second.yaml already exists; pass --force to replace it or choose a different working directory
-- want-not-a-dir.txt --
error: home/.config/invox/not-a-dir: archive.dir must point to a directory
