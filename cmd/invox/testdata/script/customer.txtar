# customer list prints ID<TAB>name<TAB>status for every customer.
exec invox customer list
cmp stdout want-list.tsv
! stderr .

# -c picks another customers file.
exec invox customer list -c other.yaml
cmp stdout want-list-other.tsv
! stderr .

# Piped output escapes backslash, tab and newline inside a field, so each
# customer stays on one line, and drops terminal escape sequences.
exec invox customer list -c escapes.yaml
cmp stdout want-list-escapes.tsv
! stderr .

# customer config opens customers.yaml in $VISUAL.
exec invox customer config
scrubpaths stdout got.txt
cmp got.txt want-config.txt
cmp stderr want-config-stderr.txt

# Without a subcommand, customer prints its help.
exec invox customer
stdout '^Customer-related commands\.$|^Usage:$'
! stderr .

# Usage errors.
exits 2 invox customer bogus
! stdout .
stderr '^error: unknown customer subcommand "bogus"$'
exits 2 invox customer list extra
! stdout .
cmp stderr want-list-extra.txt
exits 2 invox customer list --bogus
! stdout .
stderr '^error: flag provided but not defined: -bogus$'
exits 2 invox customer config extra
! stdout .
stderr '^error: unexpected arguments: extra$'

# Runtime errors.
exits 1 invox customer list -c missing.yaml
! stdout .
stderr 'missing\.yaml'
! stderr 'for usage'
env FAKE_EDITOR_FAIL=1
exits 1 invox customer config
! stdout .
scrubpaths stderr got.txt
cmp got.txt want-editor-failed.txt

-- other.yaml --
OTHER-1:
  name: Other Ltd
  status: active
-- escapes.yaml --
ESC-1:
  name: "Tab\there\nnext \e[31mred\e[0m C:\\dir"
  status: active
-- want-list-escapes.tsv --
ESC-1	Tab\there\nnext red C:\\dir	active
-- want-list.tsv --
CUST-001	Appsters GmbH	active
CUST-002	Second Customer OG	inactive
CUST-003	Third Customer KG	active
-- want-list-other.tsv --
OTHER-1	Other Ltd	active
-- want-config.txt --
Opened home/.config/invox/customers.yaml
-- want-config-stderr.txt --
fake editor: customers.yaml
-- want-list-extra.txt --
error: unexpected arguments: extra
Run 'invox customer list --help' for usage.
-- want-editor-failed.txt --
fake editor: forced failure
error: failed to open home/.config/invox/customers.yaml: exit status 1
