  vat_percent: 20
  paid_amount: 0
positions:
  - name: Example position
    unit_price: 100
    quantity: 1
-- invoice.yaml --
customer_id: CUST-001
invoice:
  number: CUST-001-001
  issue_date: 2026-03-06
  status: draft
