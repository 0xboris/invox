# Without a customers file, customer list and customer edit fail with a
# usage error that names the ways to provide one and the command's help.
env INVOX_CONFIG_DIR=$WORK/home/empty-config
mkdir home/empty-config

exits 2 invox customer list
! stdout .
scrubpaths stderr got.txt
cmp got.txt want-list.txt

exits 2 invox customer edit
! stdout .
scrubpaths stderr got.txt
cmp got.txt want-config.txt

-- want-list.txt --
error: customers file not found; pass -c/--customers, set paths.customers in config.yaml, or place customers.yaml at home/empty-config/customers.yaml
Run 'invox customer list --help' for usage.
-- want-config.txt --
error: customers file not found; pass -c/--customers, set paths.customers in config.yaml, or place customers.yaml at home/empty-config/customers.yaml
Run 'invox customer edit --help' for usage.
