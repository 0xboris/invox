# completion prints a cobra completion script for bash, zsh, fish and
# powershell. Each one asks `invox __complete` for the values.
exec invox completion bash
stdout 'complete -o default -F __start_invox invox$'
stdout '__complete'
! stderr .
exec invox completion zsh
stdout '^#compdef invox$'
stdout '__complete'
! stderr .
exec invox completion fish
stdout '^complete -c invox '
stdout '__complete'
! stderr .
exec invox completion powershell
stdout '^Register-ArgumentCompleter -CommandName ''invox'''
stdout '__complete'
! stderr .

# Without a shell it prints its help.
exec invox completion
stdout '^Generate shell completion scripts\.$'
! stderr .

exits 2 invox completion tcsh
! stdout .
cmp stderr want-tcsh.txt

exits 2 invox completion zsh extra
! stdout .
stderr '^error: unexpected arguments: zsh extra$'

# The shells and the subcommands.
exec invox __complete completion ''
cmp stdout want-shells.txt
exec invox __complete ar
cmp stdout want-archive.txt
exec invox __complete archive ''
cmp stdout want-archive-subcommands.txt

# Dynamic values: customer IDs, template names and archived invoices.
exec invox __complete new ''
cmp stdout want-customers.txt
exec invox __complete new -c other.yaml ''
cmp stdout want-other-customers.txt
exec invox __complete build x.yaml -t ''
cmp stdout want-templates.txt
exec invox __complete render -t multi
cmp stdout want-multi.txt
exec invox __complete render -t ./
cmp stdout want-files.txt
exec invox __complete archive edit ''
cmp stdout want-archived.txt

# Flags and file arguments.
exec invox __complete archive --y
cmp stdout want-yes.txt
exec invox __complete render ''
cmp stdout want-nofiles.txt
exec invox __complete validate -i ''
cmp stdout want-yaml.txt
exec invox __complete build ''
cmp stdout want-yaml.txt
exec invox __complete build -i x.yaml ''
cmp stdout want-nofiles.txt
exec invox __complete email ''
cmp stdout want-yaml-pdf.txt

# A broken config.yaml completes nothing, without an error.
cp broken.yaml home/.config/invox/config.yaml
exec invox __complete new ''
cmp stdout want-nofiles.txt
exec invox __complete archive edit ''
cmp stdout want-nofiles.txt
exec invox __complete build x.yaml -t ''
cmp stdout want-files.txt
exec invox __complete new --config other-config.yaml ''
cmp stdout want-customers.txt

# Without any support files there is nothing to complete either.
rm home/.config/invox
exec invox __complete new ''
cmp stdout want-nofiles.txt
exec invox __complete archive edit ''
cmp stdout want-nofiles.txt

-- broken.yaml --
archive:
  dir: [unclosed
-- other-config.yaml --
archive:
  dir: archive
-- home/.config/invox/config.yaml --
archive:
  dir: archive
-- home/.config/invox/customers.yaml --
CUST-001:
  name: Appsters GmbH
CUST-002:
  name: Example AG
-- other.yaml --
OTHER:
  name: Other GmbH
-- home/.config/invox/template.tex --
\documentclass{article}
-- home/.config/invox/multi_vat.tex --
\documentclass{article}
-- home/.config/invox/archive/2026-0001.yaml --
customer_id: CUST-001
invoice:
  number: 2026-0001
  issue_date: 2026-03-06
  status: archived
