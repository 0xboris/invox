# build renders the template into a temp dir, runs tectonic on it (the fake
# writes an empty PDF), copies the PDF next to the invoice and marks the
# invoice built.
exec invox build invoice.yaml
cmp stdout want-build.txt
! stderr .
exists invoice.pdf
grep '^  status: built$' invoice.yaml

# -i and -o work too.
exec invox build -i invoice.yaml -o copy.pdf
cmp stdout want-build-o.txt
! stderr .
exists copy.pdf

# Usage errors.
exits 2 invox build
! stdout .
cmp stderr want-missing-input.txt
exits 2 invox build invoice.yaml -o out.tex
! stdout .
stderr '^error: -o, --output must end with \.pdf$'
exits 2 invox build invoice.yaml other.yaml
! stdout .
stderr '^error: unexpected arguments: other\.yaml$'

# Runtime errors: tectonic fails, or is not installed. The invoice status is
# left alone.
env FAKE_TECTONIC_FAIL=1
exits 1 invox build draft.yaml
! stdout .
cmp stderr want-tectonic-failed.txt
! exists draft.pdf
grep '^  status: draft$' draft.yaml
env FAKE_TECTONIC_FAIL=
mkdir empty
env PATH=$WORK${/}empty
exits 1 $BIN${/}invox$exe build draft.yaml
! stdout .
[darwin] cmp stderr want-no-tectonic-darwin.txt
[!darwin] cmp stderr want-no-tectonic.txt
! exists draft.pdf

-- want-build.txt --
Built invoice.pdf for CUST-001 (CUST-001-001)
-- want-build-o.txt --
Built copy.pdf for CUST-001 (CUST-001-001)
-- want-missing-input.txt --
error: missing required input: INVOICE.yaml or -i, --input
Run 'invox build --help' for usage.
-- want-tectonic-failed.txt --
fake tectonic: forced failure
-- want-no-tectonic.txt --
error: tectonic not found in PATH
Install it from https://tectonic-typesetting.github.io, then rerun this command.
-- want-no-tectonic-darwin.txt --
error: tectonic not found in PATH
Install it with 'brew install tectonic', then rerun this command.
-- home/.config/invox/config.yaml --
archive:
  dir: archive
-- home/.config/invox/customers.yaml --
CUST-001:
  name: Appsters GmbH
  status: active
  email: office@appsters.example
  email_greeting: Dear Jane Doe,
  contact_person: Jane Doe
  address:
    street: Hauptstrasse 1
    postal_code: "1010"
    city: Vienna
    country: Austria
  tax:
    vat_tax_id: ATU12345678
  billing:
    currency: EUR
CUST-002:
