-- home/.config/invox/invoice_defaults.yaml --
invoice:
  period: "Leistungszeitraum: "
  vat_percent: 20
  paid_amount: 0
positions:
  - name: Example position
    description: Description of the delivered service
    unit_price: 100
    quantity: 1
-- home/.config/invox/template.tex --
Invoice @@INVOICE_NUMBER@@ for @@CUSTOMER_NAME@@
Issued @@ISSUE_DATE@@, due @@DUE_DATE@@
@@LINE_ITEMS_ROWS@@
Subtotal @@SUBTOTAL@@
@@VAT_SUMMARY_ROWS@@
Total @@TOTAL@@
Outstanding @@OUTSTANDING_AMOUNT@@
@@PAYMENT_TERMS_TEXT@@
IBAN @@IBAN@@
-- invoice.yaml --
