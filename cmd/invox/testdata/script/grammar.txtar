# increment, validate and render take the invoice as the INVOICE argument,
# as build, email and archive add do, and -i, --input still works. Naming
# the same file both ways is fine; naming two files is a usage error, the
# same on every command.

exec invox validate invoice.yaml
! stdout .
cmp stderr want-validate.txt
exec invox validate ./invoice.yaml -i invoice.yaml
! stdout .
cmp stderr want-validate.txt
exec invox validate invoice.yaml -i $WORK${/}invoice.yaml
! stdout .
cmp stderr want-validate.txt
exec invox validate $WORK${/}invoice.yaml -i invoice.yaml
! stdout .
cmp stderr want-validate.txt
exec invox render invoice.yaml -n
cmp stdout want-render-stdout.txt
cmp stderr want-render.txt
exec invox increment invoice.yaml -n
cmp stdout want-increment-stdout.txt
cmp stderr want-increment.txt

exits 2 invox increment a.yaml -i b.yaml
! stdout .
cmp stderr want-increment-both.txt
exits 2 invox validate a.yaml -i b.yaml
! stdout .
cmp stderr want-validate-both.txt
exits 2 invox render a.yaml -i b.yaml
! stdout .
cmp stderr want-render-both.txt
exits 2 invox build a.yaml -i b.yaml
! stdout .
cmp stderr want-build-both.txt
exits 2 invox email a.yaml -i b.yaml
! stdout .
cmp stderr want-email-both.txt
exits 2 invox archive add a.yaml -i b.yaml
! stdout .
cmp stderr want-archive-add-both.txt

# One INVOICE argument at most, and one of the two ways is required.
exits 2 invox validate a.yaml b.yaml
! stdout .
cmp stderr want-validate-extra.txt
exits 2 invox render
! stdout .
cmp stderr want-render-missing.txt

# The shell completes YAML files for the INVOICE argument.
exec invox __complete increment ''
cmp stdout want-complete-increment.txt

# config edit is what config does without a subcommand: open config.yaml in
# the editor, which needs a terminal.
exits 2 invox config edit
! stdout .
scrubpaths stderr got.txt
cmp got.txt want-config-edit.txt
exits 2 invox config edit extra
! stdout .
cmp stderr want-config-edit-extra.txt

# The forms #106 deprecated are gone: archive FILE, customer config, send
# and new -s/--source are usage errors, and help has no page for them.
exits 2 invox archive invoice.yaml
! stdout .
cmp stderr want-archive-file.txt
exists invoice.yaml
exits 2 invox customer config
! stdout .
cmp stderr want-customer-config.txt
exits 2 invox send invoice.yaml --to someone@example.com
! stdout .
cmp stderr want-send.txt
exits 2 invox new CUST-001 -s defaults.yaml
! stdout .
cmp stderr want-new-s.txt
exits 2 invox new CUST-001 --source defaults.yaml
! stdout .
cmp stderr want-new-source.txt
exits 2 invox help customer config
! stdout .
cmp stderr want-help-customer-config.txt
exits 2 invox help send
! stdout .
cmp stderr want-help-send.txt

