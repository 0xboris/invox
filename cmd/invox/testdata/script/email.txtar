# email builds a message from the invoice and opens it in the mail app.
#
# On macOS, without -o, invox hands the message to Apple Mail through
# osascript; everywhere else, and whenever -o is given, it writes a .eml
# draft and opens that with open/xdg-open/`cmd /c start`. These scripts always
# pass -o so every OS takes the same path; email_macos covers the osascript
# path. The fake opener prints the file it was asked to open.
exec invox email invoice.yaml -o draft.eml
cmp stdout want-email.txt
cmp stderr want-email-stderr.txt

# An -o draft is kept, and an existing file is only replaced with --force.
exists draft.eml
grep '^To: .*office@appsters\.example' draft.eml
cp keep.eml existing.eml
exits 1 invox email invoice.yaml -o existing.eml
! stdout .
scrubpaths stderr got.txt
cmp got.txt want-exists.txt
cmp existing.eml keep.eml
exec invox email invoice.yaml -o existing.eml --force
cmp stdout want-force.txt
cmp stderr want-force-stderr.txt
grep '^To: .*office@appsters\.example' existing.eml

# The PDF can be the input; --to and --subject override the defaults.
exec invox email invoice.pdf -o draft2.eml --to someone@example.com --subject 'Re: {invoice_number}'
cmp stdout want-email-to.txt
cmp stderr want-email-to-stderr.txt

# send is an alias.
exec invox send -i invoice.yaml -o draft3.eml
cmp stdout want-send.txt
cmp stderr want-send-stderr.txt

# Without -o, the draft goes into a new temporary directory, which a later run
# removes after 24 hours; the default <input>.eml is not written. macOS
# takes the osascript path instead (email_macos).
[!darwin] exec invox email invoice.yaml
[!darwin] ! stdout .
[!darwin] cmp stderr want-email-temp-stderr.txt
! exists invoice.eml

# Usage errors.
exits 2 invox email
! stdout .
cmp stderr want-missing-input.txt
exits 2 invox email invoice.txt -o draft.eml
! stdout .
stderr '^error: input must end with \.yaml, \.yml, or \.pdf$'
exits 2 invox email invoice.yaml -o draft.txt
! stdout .
stderr '^error: -o, --output must end with \.eml$'
exits 2 invox email invoice.yaml -p invoice.txt -o draft.eml
! stdout .
stderr '^error: -p, --pdf must end with \.pdf$'

# Runtime errors: the invoice is not built yet, the PDF is missing, and the
# mail app cannot be opened.
exits 1 invox email draft.yaml -p invoice.pdf -o draft4.eml
! stdout .
scrubpaths stderr got.txt
cmp got.txt want-not-built.txt
exits 1 invox email invoice.yaml -p missing.pdf -o draft5.eml
! stdout .
stderr '^error: read missing\.pdf: '
env FAKE_OPEN_FAIL=1
exits 1 invox email invoice.yaml -o draft6.eml
! stdout .
cmp stderr want-open-failed.txt

-- keep.eml --
keep me
-- invoice.pdf --
-- want-exists.txt --
error: existing.eml already exists; pass --force or choose another -o path
-- want-force.txt --
existing.eml
-- want-force-stderr.txt --
fake open: existing.eml
Opened email draft for CUST-001 (CUST-001-001) to office@appsters.example
-- want-email.txt --
draft.eml
-- want-email-stderr.txt --
fake open: draft.eml
Opened email draft for CUST-001 (CUST-001-001) to office@appsters.example
-- want-email-to.txt --
draft2.eml
-- want-email-to-stderr.txt --
fake open: draft2.eml
Opened email draft for CUST-001 (CUST-001-001) to someone@example.com
-- want-email-temp-stderr.txt --
fake open: invoice.eml
Opened email draft for CUST-001 (CUST-001-001) to office@appsters.example
-- want-send.txt --
draft3.eml
-- want-send-stderr.txt --
fake open: draft3.eml
Opened email draft for CUST-001 (CUST-001-001) to office@appsters.example
-- want-missing-input.txt --
error: missing required input: INVOICE.yaml, INVOICE.pdf, or -i, --input
Run 'invox email --help' for usage.
-- want-not-built.txt --
error: draft.yaml: invoice.status must be `built` or `archived` before creating an email draft, got `draft`
-- want-open-failed.txt --
fake open: forced failure
error: created draft6.eml but failed to open it: exit status 1
-- home/.config/invox/config.yaml --
archive:
  dir: archive
-- home/.config/invox/customers.yaml --
CUST-001:
  name: Appsters GmbH
  status: active
  email: office@appsters.example
  email_greeting: Dear Jane Doe,
  contact_person: Jane Doe
  address:
    street: Hauptstrasse 1
    postal_code: "1010"
    city: Vienna
    country: Austria
  tax:
    vat_tax_id: ATU12345678
  billing:
    currency: EUR
CUST-002:
  name: Second Customer OG
  status: inactive
  email: billing@second.example
  address:
    street: Nebenstrasse 2
    postal_code: "8010"
    city: Graz
    country: Austria
CUST-003:
  name: Third Customer KG
  status: active
  email: billing@third.example
  address:
    street: Seeweg 3
    postal_code: "5020"
    city: Salzburg
    country: Austria
