# new writes <number>.yaml from invoice_defaults.yaml with a generated number.
# The issue and due dates come from the clock, so they are matched loosely.
exec invox new CUST-001
cmp stdout want-new-stdout.txt
cmp stderr want-new.txt
grep '^  number: CUST-001-001$' CUST-001-001.yaml
grep '^  status: draft$' CUST-001-001.yaml
grep '^  issue_date: "?\d{4}-\d{2}-\d{2}"?$' CUST-001-001.yaml
grep '^customer_id: CUST-001$' CUST-001-001.yaml

# Drafts in the working directory count: the next draft gets the next number.
exec invox new CUST-001 -o second.yaml
cmp stdout want-second-stdout.txt
cmp stderr want-second.txt

# -o picks the output path.
exec invox new CUST-002 -o drafts.yaml
cmp stdout want-new-o-stdout.txt
cmp stderr want-new-o.txt
exists drafts.yaml

# -e opens the new invoice in an editor, which needs a terminal. Without one
# the invoice is still created.
exits 2 invox new CUST-003 -e
! stdout .
cmp stderr want-new-e-stderr.txt
exists CUST-003-001.yaml

# Usage errors.
exits 2 invox new
! stdout .
cmp stderr want-missing-id.txt
exits 2 invox new --bogus
! stdout .
stderr '^error: flag provided but not defined: -bogus$'
exits 2 invox new CUST-001 -o out.txt
! stdout .
stderr '^error: -o, --output must end with \.yaml$'
exits 2 invox new CUST-001 extra
! stdout .
stderr '^error: unexpected arguments: extra$'

# Runtime error: an unknown customer.
exits 1 invox new NOPE-1 -o nope.yaml
! stdout .
scrubpaths stderr got.txt
cmp got.txt want-unknown.txt
! exists nope.yaml

-- want-new.txt --
Created CUST-001-001.yaml for CUST-001 (CUST-001-001)
-- want-second.txt --
Created second.yaml for CUST-001 (CUST-001-002)
-- want-new-o.txt --
Created drafts.yaml for CUST-002 (CUST-002-001)
-- want-new-e-stderr.txt --
error: created CUST-003-001.yaml but cannot open an editor: stdin is not a terminal; edit it and run 'invox validate -i CUST-003-001.yaml'
Run 'invox new --help' for usage.
-- want-missing-id.txt --
error: missing required arguments: CUSTOMER_ID
Run 'invox new --help' for usage.
-- want-unknown.txt --
error: home/.config/invox/customers.yaml: unknown customer_id `NOPE-1`
Run 'invox customer list' to see the customer IDs.
