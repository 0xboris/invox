# archive add, archive edit and archive list parse their flags with pflag.

# A misspelt flag after the positional suggests the right one.
exits 2 invox archive add F.yaml --yse
! stdout .
cmp stderr want-misspelt.txt

# -i naming another file than the positional is a usage error.
exits 2 invox archive add F.yaml -i x.yaml
! stdout .
cmp stderr want-both.txt

# A dangling -i names the flag.
exits 2 invox archive add -i
! stdout .
cmp stderr want-dangling.txt

# Subcommands report unknown flags too.
exits 2 invox archive list --bogus
! stdout .
stderr '^error: unknown flag: --bogus$'
stderr '^Run ''invox archive list --help'' for usage\.$'

# A single-dash long flag is a usage error that names the double-dash one.
exits 2 invox archive add F.yaml -yes
! stdout .
cmp stderr want-single-dash.txt

-- want-misspelt.txt --
error: unknown flag: --yse; did you mean --yes?
Run 'invox archive add --help' for usage.
-- want-both.txt --
error: the INVOICE argument F.yaml and -i, --input x.yaml name different files; pass only one
Run 'invox archive add --help' for usage.
-- want-dangling.txt --
error: flag needs an argument: -i
Run 'invox archive add --help' for usage.
-- want-single-dash.txt --
error: -yes is not a flag; use --yes
Run 'invox archive add --help' for usage.
