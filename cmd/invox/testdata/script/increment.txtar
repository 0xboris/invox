# increment bumps the counter in invoice.number in place.
exec invox increment -i invoice.yaml
cmp stdout want-increment.txt
! stderr .
grep '^  number: CUST-001-002$' invoice.yaml

# Usage errors.
exits 2 invox increment
! stdout .
cmp stderr want-missing-input.txt
exits 2 invox increment -i invoice.yaml extra
! stdout .
stderr '^error: unexpected arguments: extra$'

# Runtime errors.
exits 1 invox increment -i missing.yaml
! stdout .
stderr 'missing\.yaml'
! stderr 'for usage'
exits 1 invox increment -i foreign.yaml
! stdout .
scrubpaths stderr got.txt
cmp got.txt want-foreign.txt

-- foreign.yaml --
customer_id: NOPE-1
invoice:
  number: NOPE-1-001
  issue_date: 2026-03-06
-- want-increment.txt --
Incremented invoice.yaml for CUST-001: CUST-001-001 -> CUST-001-002
-- want-missing-input.txt --
error: missing required flags: -i, --input
Run 'invox increment --help' for usage.
-- want-foreign.txt --
error: home/.config/invox/customers.yaml: unknown customer_id `NOPE-1`
Run 'invox customer list' to see the customer IDs.
-- home/.config/invox/config.yaml --
archive:
  dir: archive
