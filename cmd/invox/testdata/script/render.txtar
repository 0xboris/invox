# render fills the LaTeX template from the invoice and writes the .tex file.
exec invox render -i invoice.yaml
cmp stdout want-render-stdout.txt
cmp stderr want-render.txt
cmp invoice.tex want-invoice.tex

exec invox render -i invoice.yaml -o out.tex -t ./other.tex
cmp stdout want-render-o-stdout.txt
cmp stderr want-render-o.txt
cmp out.tex want-other.tex

# A value that looks like a placeholder is rendered literally.
exec invox render -i atat.yaml -o atat.tex
cmp stdout want-atat-stdout.txt
stderr '^Rendered atat\.tex for CUST-001 \(CUST-001-001\)$'
cmp atat.tex want-atat.tex

# Usage errors.
exits 2 invox render
! stdout .
cmp stderr want-missing-input.txt
exits 2 invox render -i invoice.yaml -o out.pdf
! stdout .
stderr '^error: -o, --output must end with \.tex$'
# A bare -t value is a catalog name, not a path.
exits 2 invox render -i invoice.yaml -t other.tex
! stdout .
stderr '^error: template "other.tex" not found; run ''invox template list'' to see the templates$'
exits 2 invox render -i invoice.yaml -t nosuch
! stdout .
stderr '^error: template "nosuch" not found; run ''invox template list'' to see the templates$'

# Runtime error: the invoice does not validate; nothing is written.
exits 1 invox render -i foreign.yaml -o foreign.tex
! stdout .
scrubpaths stderr got.txt
cmp got.txt want-foreign.txt
! exists foreign.tex

-- atat.yaml --
customer_id: CUST-001
invoice:
  number: CUST-001-001
  issue_date: 2026-03-06
  due_date: 2026-04-05
  period: March
  vat_percent: 20
positions:
  - name: Development
    description: Ref @@TOTAL@@
    unit_price: 100
    quantity: 1
-- want-atat.tex --
Invoice CUST-001-001 for Appsters GmbH
Issued 06.03.2026, due 05.04.2026
    Development & Ref @@TOTAL@@ & 100,00 \euro & 1 & 100,00 \euro\\
    \specialrule{0.4pt}{0pt}{0pt}
Subtotal 100,00 \euro
VAT (20\%): & 20,00 \euro\\
Total 120,00 \euro
Outstanding 120,00 \euro
Pay within 30 days
IBAN AT611904300234573201
-- other.tex --
@@INVOICE_NUMBER@@/@@CUSTOMER_NAME@@/@@TOTAL@@
-- foreign.yaml --
customer_id: NOPE-1
invoice:
  number: NOPE-1-001
  issue_date: 2026-03-06
  due_date: 2026-04-05
  period: March
  vat_percent: 20
positions:
  - name: Development
    description: Sprint work
    unit_price: 100
    quantity: 1
-- want-render.txt --
Rendered invoice.tex for CUST-001 (CUST-001-001)
-- want-invoice.tex --
Invoice CUST-001-001 for Appsters GmbH
Issued 06.03.2026, due 05.04.2026
    Development & Sprint work & 100,00 \euro & 2 & 200,00 \euro\\
    \specialrule{0.2pt}{0pt}{0pt}
    Support & QA & 10,00 \euro & 1 & 10,00 \euro\\
    \specialrule{0.4pt}{0pt}{0pt}
Subtotal 210,00 \euro
VAT (20\%): & 42,00 \euro\\
Total 252,00 \euro
Outstanding 252,00 \euro
Pay within 30 days
IBAN AT611904300234573201
-- want-render-o.txt --
Rendered out.tex for CUST-001 (CUST-001-001)
-- want-other.tex --
CUST-001-001/Appsters GmbH/252,00 \euro
-- want-missing-input.txt --
error: missing required flags: -i, --input
Run 'invox render --help' for usage.
-- want-foreign.txt --
error: foreign.yaml: unknown customer_id `NOPE-1`
Run 'invox customer list' to see the customer IDs.
