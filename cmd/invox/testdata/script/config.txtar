# config creates config.yaml from its template if needed and opens it in an
# editor. The script's stdin is not a terminal, so no editor opens and config
# fails with a usage error after creating the file.
exits 2 invox config
! stdout .
scrubpaths stderr got.txt
cmp got.txt want-no-terminal.txt
scrubpaths home/.config/invox/config.yaml got.yaml
cmp got.yaml want-config.yaml

# An existing config.yaml is left unchanged.
cp custom.yaml home/.config/invox/config.yaml
exits 2 invox config
! stdout .
scrubpaths stderr got.txt
cmp got.txt want-no-terminal.txt
cmp home/.config/invox/config.yaml custom.yaml

# --no-input and INVOX_PROMPT_DISABLED say why no editor opens.
exits 2 invox --no-input config
! stdout .
scrubpaths stderr got.txt
cmp got.txt want-disabled.txt
env INVOX_PROMPT_DISABLED=1
exits 2 invox config
! stdout .
scrubpaths stderr got.txt
cmp got.txt want-disabled.txt
env INVOX_PROMPT_DISABLED=

# Usage error: config takes no arguments.
exits 2 invox config extra
! stdout .
cmp stderr want-usage.txt

-- custom.yaml --
archive:
  dir: archive
-- want-no-terminal.txt --
error: cannot open an editor: stdin is not a terminal; edit home/.config/invox/config.yaml directly
Run 'invox config --help' for usage.
-- want-disabled.txt --
error: cannot open an editor: prompts are disabled (--no-input or INVOX_PROMPT_DISABLED); edit home/.config/invox/config.yaml directly
Run 'invox config --help' for usage.
-- want-config.yaml --
# Invox user configuration.
#
# Uncomment a setting and change it to override the default.
#
# Supported settings:
#   paths.customers
#   paths.issuer
#   paths.defaults
#   paths.template
#   numbering.pattern
#   numbering.start
#   archive.dir
#     Directory where archived invoice files are stored.
#   email.subject
#     Subject template for the email command.
#   email.body
#     Plain-text body template for the email command.
#     Supported placeholders for email.subject and email.body:
#       {customer_name}
#       {email_greeting}
#       {contact_person}
#       {customer_id}
#       {invoice_number}
#       {issue_date}
#       {due_date}
#       {total_amount}
#       {outstanding_amount}
#       {payment_terms_text}
#       {issuer_name}
#
# Notes:
# - Top-level keys must not be indented.
# - Relative paths are resolved relative to this file.
# - "~/" expands to your home directory.
# - Per-customer numbering overrides live in customers.yaml at:
#   <customer>.numbering.start
# - Support file resolution order is:
#   1. explicit CLI flag
#   2. upward project search
#   3. paths.* in this file
#   4. conventional files in this config directory
#
# paths:
#   customers: 'customers.yaml'
#   issuer: 'issuer.yaml'
#   defaults: 'invoice_defaults.yaml'
#   template: 'template.tex'
#
# numbering:
#   pattern: '{customer_code}-{counter:03}'
#   start: 1
#
# archive:
#   dir: '$DATA_HOME_TILDE/invox/invoices'
#
# email:
#   subject: 'Invoice {invoice_number}'
#   body: |
#     {email_greeting}
#     
#     Please find attached invoice {invoice_number}.
#     Issue date: {issue_date}
#     Due date: {due_date}
#     Outstanding amount: {outstanding_amount}
#     
#     Regards,
#     {issuer_name}
-- want-usage.txt --
error: unexpected arguments: extra
Run 'invox config --help' for usage.
