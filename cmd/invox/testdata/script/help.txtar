# Help routing: every way of asking for a page prints the same page on stdout,
# with exit 0 and nothing on stderr. The pages themselves are pinned by
# docs/cli, which `go run ./internal/docs/gen` regenerates and CI checks.
# Pages are compared to each other here; the regexps check which page it is.
# Every command's `help X` against `X --help` is TestEveryCommandHelpHasAnExample.

# Root help: no topic, and both help flags.
exec invox help
stdout '^  invox <command> \[flags\]$'
! stderr .
cp stdout root.txt
exec invox --help
cmp stdout root.txt
! stderr .
exec invox -h
cmp stdout root.txt
! stderr .
exits 2 invox -help
! stdout .
cmp stderr want-help-single-dash.txt

# A command: `help CMD`, `CMD --help` and `CMD -h`.
exec invox help new
stdout '^  invox new CUSTOMER_ID \[flags\]$'
! stderr .
cp stdout new.txt
exec invox new --help
cmp stdout new.txt
! stderr .
exec invox new -h
cmp stdout new.txt
! stderr .

# A subcommand.
exec invox help archive add
stdout '^  invox archive add \[INVOICE.yaml\] \[flags\]$'
! stderr .
cp stdout archive-add.txt
exec invox archive add --help
cmp stdout archive-add.txt
! stderr .
exec invox archive add -h
cmp stdout archive-add.txt
! stderr .
exec invox help customer edit
stdout '^  invox customer edit \[flags\]$'
! stderr .
cp stdout customer-edit.txt
exec invox customer edit --help
cmp stdout customer-edit.txt
! stderr .
exec invox customer edit -h
cmp stdout customer-edit.txt
! stderr .

# A command group, and the group without a subcommand.
exec invox help archive
stdout '^  invox archive <subcommand> \[flags\]$'
! stderr .
cp stdout archive.txt
exec invox archive --help
cmp stdout archive.txt
! stderr .
exec invox archive -h
cmp stdout archive.txt
! stderr .
exec invox archive
cmp stdout archive.txt
! stderr .
exec invox help customer
stdout '^  invox customer <subcommand> \[flags\]$'
! stderr .
cp stdout customer.txt
exec invox customer
cmp stdout customer.txt
! stderr .
exec invox help template
stdout '^  invox template <subcommand> \[flags\]$'
! stderr .
cp stdout template.txt
exec invox template
cmp stdout template.txt
! stderr .

# config and template are help topics that print the command's page.
exec invox help config
stdout '^  invox config \[flags\]$'
! stderr .
cp stdout config.txt
exec invox config --help
cmp stdout config.txt
! stderr .
exec invox template --help
cmp stdout template.txt
! stderr .

# Topics with their own page, and the aliases of defaults.
exec invox help customers
stdout '^  invox help customers$'
! stderr .
exec invox help issuer
stdout '^  invox help issuer$'
! stderr .
exec invox help environment
stdout '^  invox help environment$'
! stderr .
exec invox help exit-codes
stdout '^  invox help exit-codes$'
! stderr .
exec invox help defaults
stdout '^  invox help defaults$'
! stderr .
cp stdout defaults.txt
exec invox help invoice-defaults
cmp stdout defaults.txt
! stderr .
exec invox help invoice_defaults
cmp stdout defaults.txt
! stderr .

# Pages name the directories of this process's environment, on every OS.
# docs/cli shows them for $HOME with no variables set.
scrubpaths root.txt got.txt
grep '^  customers.yaml: upward project search, then \$WORK/home/.config/invox/customers.yaml$' got.txt
grep '^  issuer.yaml: upward project search, then \$WORK/home/.config/invox/issuer.yaml$' got.txt
grep '^  invoice_defaults.yaml: upward project search, then \$WORK/home/.config/invox/invoice_defaults.yaml$' got.txt
grep '^  template.tex: upward project search, then \$WORK/home/.config/invox/template.tex$' got.txt
scrubpaths config.txt got.txt
grep '^  default: \$WORK/home/.config/invox/config.yaml$' got.txt
grep '^  4. conventional files in \$WORK/home/.config/invox$' got.txt
grep '^#   dir: ''\$DATA_HOME_TILDE/invox/invoices''$' got.txt
scrubpaths archive.txt got.txt
grep '^  archive.dir: config.yaml, then \$DATA_HOME/invox/invoices$' got.txt

# Help never needs the config: it works before init.
! exists home/.config/invox

-- want-help-single-dash.txt --
error: -help is not a flag; use --help
Run 'invox --help' for usage.
