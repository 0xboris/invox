# Every help topic and every command's help page, on stdout with exit 0.
# Help output has absolute, OS-specific paths; scrubpaths makes them portable.

# Root help: no topic, and every help flag.
exec invox help
scrubpaths stdout got.txt
cmp got.txt want-root.txt
! stderr .
exec invox --help
scrubpaths stdout got.txt
cmp got.txt want-root.txt
! stderr .
exec invox -h
scrubpaths stdout got.txt
cmp got.txt want-root.txt
! stderr .
exits 2 invox -help
! stdout .
cmp stderr want-help-single-dash.txt

# Documentation topics.
exec invox help customers
scrubpaths stdout got.txt
cmp got.txt want-customers.txt
! stderr .
exec invox help issuer
scrubpaths stdout got.txt
cmp got.txt want-issuer.txt
! stderr .
exec invox help defaults
scrubpaths stdout got.txt
cmp got.txt want-defaults.txt
! stderr .
exec invox help invoice-defaults
scrubpaths stdout got.txt
cmp got.txt want-defaults.txt
! stderr .
exec invox help invoice_defaults
scrubpaths stdout got.txt
cmp got.txt want-defaults.txt
! stderr .
exec invox help template
scrubpaths stdout got.txt
cmp got.txt want-template.txt
! stderr .
exec invox help config
scrubpaths stdout got.txt
cmp got.txt want-config.txt
! stderr .

# Command help: `help CMD` and `CMD --help` print the same page.
exec invox help customer
scrubpaths stdout got.txt
cmp got.txt want-customer.txt
! stderr .
exec invox customer --help
scrubpaths stdout got.txt
cmp got.txt want-customer.txt
exec invox help customer list
scrubpaths stdout got.txt
cmp got.txt want-customer-list.txt
! stderr .
exec invox customer list --help
scrubpaths stdout got.txt
cmp got.txt want-customer-list.txt

exec invox help customer edit
scrubpaths stdout got.txt
cmp got.txt want-customer-edit.txt
! stderr .

exec invox customer edit -h
scrubpaths stdout got.txt
cmp got.txt want-customer-edit.txt

exec invox config --help
scrubpaths stdout got.txt
cmp got.txt want-config.txt
! stderr .

exec invox help config edit
scrubpaths stdout got.txt
cmp got.txt want-config-edit.txt
! stderr .

exec invox config edit --help
scrubpaths stdout got.txt
cmp got.txt want-config-edit.txt
exec invox help init
scrubpaths stdout got.txt
cmp got.txt want-init.txt
! stderr .
exec invox init --help
scrubpaths stdout got.txt
cmp got.txt want-init.txt
exec invox template --help
scrubpaths stdout got.txt
cmp got.txt want-template.txt
exec invox help template list
scrubpaths stdout got.txt
cmp got.txt want-template-list.txt
! stderr .
exec invox template list --help
scrubpaths stdout got.txt
cmp got.txt want-template-list.txt
# The completion help has no sandbox paths, and its ~/.local/share is literal.
exec invox help completion
cmp stdout want-completion.txt
! stderr .
exec invox completion --help
cmp stdout want-completion.txt
exec invox help new
scrubpaths stdout got.txt
cmp got.txt want-new.txt
! stderr .
exec invox new --help
scrubpaths stdout got.txt
cmp got.txt want-new.txt
exec invox help increment
scrubpaths stdout got.txt
cmp got.txt want-increment.txt
! stderr .
exec invox increment --help
scrubpaths stdout got.txt
cmp got.txt want-increment.txt
exec invox help validate
scrubpaths stdout got.txt
cmp got.txt want-validate.txt
! stderr .
exec invox validate --help
scrubpaths stdout got.txt
cmp got.txt want-validate.txt
exec invox help render
scrubpaths stdout got.txt
cmp got.txt want-render.txt
! stderr .
exec invox render --help
scrubpaths stdout got.txt
cmp got.txt want-render.txt
exec invox help email
scrubpaths stdout got.txt
cmp got.txt want-email.txt
! stderr .
exec invox email --help
scrubpaths stdout got.txt
cmp got.txt want-email.txt
exec invox help build
scrubpaths stdout got.txt
cmp got.txt want-build.txt
! stderr .
exec invox build --help
scrubpaths stdout got.txt
cmp got.txt want-build.txt
exec invox help archive
scrubpaths stdout got.txt
cmp got.txt want-archive.txt
! stderr .
exec invox archive --help
scrubpaths stdout got.txt
cmp got.txt want-archive.txt
exec invox archive
scrubpaths stdout got.txt
cmp got.txt want-archive.txt
! stderr .

exec invox help archive add
scrubpaths stdout got.txt
cmp got.txt want-archive-add.txt
! stderr .

exec invox archive add --help
scrubpaths stdout got.txt
cmp got.txt want-archive-add.txt
exec invox help archive edit
scrubpaths stdout got.txt
cmp got.txt want-archive-edit.txt
! stderr .
exec invox archive edit --help
