# Every deprecated form still works like its replacement. It prints the same
# stdout and exit code, plus one warning line on stderr, and help and
# completion leave it out. archive.dir is set in config.yaml (relative to it)
# so the paths are the same on every OS.

# archive FILE is archive add FILE, with every flag archive add takes.
exec invox archive add first.yaml -n
cp stdout add-stdout.txt
scrubpaths stderr got.txt
cmp got.txt want-add-dry-run.txt
exec invox archive first.yaml -n
cmp stdout add-stdout.txt
scrubpaths stderr got.txt
cmp got.txt want-archive-dry-run.txt
exec invox archive --dry-run -i first.yaml --json path
stdout '^\{"path":".*first\.yaml"\}$'
stderr '^warning: archive FILE is deprecated; use archive add FILE$'
exec invox archive first.yaml --yes
cmp stdout add-stdout.txt
scrubpaths stderr got.txt
cmp got.txt want-archive.txt
! exists first.yaml

# Usage errors of archive FILE are unchanged and print no warning. A
# misspelt flag still gets a suggestion, though help leaves the flags out.
exits 2 invox archive
! stdout .
cmp stderr want-archive-missing.txt
exits 2 invox archive F.yaml --yse
! stdout .
cmp stderr want-archive-misspelt.txt
exits 2 invox archive F.yaml -i x.yaml
! stdout .
cmp stderr want-archive-both.txt

# Bare --json lists the fields and exits 1, though help leaves them out.
exits 1 invox archive F.yaml --json
! stdout .
cmp stderr want-archive-json-fields.txt

# A file named list or edit is archived with archive add.
exec invox archive add list --yes
scrubpaths stdout got.txt
cmp got.txt want-list-stdout.txt
! exists list

# customer config is customer edit.
exits 2 invox customer config
! stdout .
scrubpaths stderr got.txt
cmp got.txt want-customer-config.txt

# new -s and --source are new --defaults.
exec invox new CUST-001 --defaults home/.config/invox/invoice_defaults.yaml -n
cp stdout new-stdout.txt
cmp stderr want-new-defaults.txt
exec invox new CUST-001 -s home/.config/invox/invoice_defaults.yaml -n
cmp stdout new-stdout.txt
cmp stderr want-new-source.txt
exec invox new CUST-001 --source=home/.config/invox/invoice_defaults.yaml -n
cmp stdout new-stdout.txt
cmp stderr want-new-source.txt

# send is email, and says that it only drafts one.
exits 2 invox send
! stdout .
cmp stderr want-send.txt

# Completion offers only the new forms.
exec invox __complete archive ''
cmp stdout want-complete-archive.txt
exec invox __complete customer ''
cmp stdout want-complete-customer.txt
exec invox __complete new CUST-001 --
! stdout '^--source'
stdout '^--defaults'
exec invox __complete s
! stdout '^send'

-- want-add-dry-run.txt --
Would archive first.yaml -> home/.config/invox/archive/first.yaml
-- want-archive-dry-run.txt --
warning: archive FILE is deprecated; use archive add FILE
Would archive first.yaml -> home/.config/invox/archive/first.yaml
-- want-archive.txt --
warning: archive FILE is deprecated; use archive add FILE
Archived first.yaml -> home/.config/invox/archive/first.yaml
-- want-archive-missing.txt --
error: missing required input: INVOICE.yaml or -i, --input
Run 'invox archive --help' for usage.
-- want-archive-misspelt.txt --
error: unknown flag: --yse; did you mean --yes?
Run 'invox archive --help' for usage.
-- want-archive-both.txt --
error: the INVOICE argument F.yaml and -i, --input x.yaml name different files; pass only one
Run 'invox archive --help' for usage.
-- want-archive-json-fields.txt --
