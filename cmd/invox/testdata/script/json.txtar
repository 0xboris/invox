# --json prints one JSON document on stdout in place of the usual output:
# an array for list commands, [] when there is nothing to list, and an object
# for validate and the commands that write files. Status lines stay on
# stderr. Piped, the JSON is compact. archive.dir is set in config.yaml
# (relative to it) so the paths are the same on every OS.

# Empty lists are [], not null and not the "no results" hint.
exec invox archive list --json file,path
cmp stdout want-empty.json
! stderr .

# Bare --json lists the fields and exits 1; an unknown field is a usage error
# that lists them too. Neither writes to stdout.
exits 1 invox customer list --json
! stdout .
cmp stderr want-bare.txt
exits 1 invox archive list --json=
! stdout .
stderr '^error: specify one or more comma-separated fields for --json:$'
exits 2 invox customer list --json id,bogus
! stdout .
cmp stderr want-unknown.txt
exits 2 invox template list --names --json name
! stdout .
cmp stderr want-names-json.txt

# The shell completes field names after a comma.
exec invox __complete customer list --json id,
cmp stdout want-complete.txt

# List commands.
exec invox customer list --json id,name,status,email,currency
cmp stdout want-customers.json
! stderr .
exec invox customer list --json id
cmp stdout want-customer-ids.json
exec invox template list --json name,path,default
scrubpaths -json stdout got.json
cmp got.json want-templates.json
! stderr .

# validate: valid and invalid. Invalid still prints the document, with the
# invoice's fields null, and exits 1 with the usual error on stderr.
exec invox validate -i invoice.yaml --json valid,number,customerId,lineItems,total,currency,errors
cmp stdout want-valid.json
cmp stderr want-valid-stderr.txt
exits 1 invox validate -i invalid.yaml --json valid,number,total,errors
scrubpaths -json stdout got.json
cmp got.json want-invalid.json
scrubpaths stderr got.txt
cmp got.txt want-invalid-stderr.txt
# A file that cannot be read is not an invalid invoice: no JSON.
exits 1 invox validate -i missing.yaml --json valid
! stdout .
stderr 'missing\.yaml'

# Commands that write files print what they wrote.
exec invox new CUST-002 --json path,number,customerId
scrubpaths -json stdout got.json
cmp got.json want-new.json
cmp stderr want-new-stderr.txt
exec invox increment -i CUST-002-001.yaml --json path,number,previousNumber,customerId
scrubpaths -json stdout got.json
cmp got.json want-increment.json
exec invox render -i invoice.yaml -o out.tex --json path,input,number,customerId
scrubpaths -json stdout got.json
cmp got.json want-render.json
exec invox build invoice.yaml --json path,input,number,customerId,archivedPath
scrubpaths -json stdout got.json
cmp got.json want-build.json
exec invox build second.yaml --archive --json path,archivedPath
scrubpaths -json stdout got.json
cmp got.json want-build-archive.json
exec invox archive invoice.yaml --json path,input,replaced
scrubpaths -json stdout got.json
cmp got.json want-archive.json
exec invox archive list --json file,path,customerId,number,issueDate,status
scrubpaths -json stdout got.json
cmp got.json want-archive-list.json
exec invox archive edit invoice.yaml --json path,archivedPath
scrubpaths -json stdout got.json
cmp got.json want-edit.json
# The backup's name has the time in it, so it is matched loosely.
exec invox archive invoice.yaml --yes --json replaced
stdout '^\{"replaced":\[\{"path":"[^"]*archive[/\\]+invoice\.yaml","backupPath":"[^"]*archive[/\\]+\.history[/\\]+invoice\.\d{8}T\d{6}Z\.yaml"\}\]\}$'

-- want-empty.json --
[]
-- want-bare.txt --
error: specify one or more comma-separated fields for --json:
  currency
  email
  id
  name
  status
-- want-unknown.txt --
error: unknown JSON field: "bogus"
Available fields:
  currency
  email
  id
  name
  status
Run 'invox customer list --help' for usage.
-- want-names-json.txt --
error: --names and --json cannot be used together
Run 'invox template list --help' for usage.
-- want-complete.txt --
id,currency
id,email
id,name
id,status
:6
-- want-customers.json --
[{"currency":"EUR","email":"office@appsters.example","id":"CUST-001","name":"Appsters GmbH","status":"active"},{"currency":"EUR","email":"billing@second.example","id":"CUST-002","name":"Second Customer OG","status":"inactive"},{"currency":"EUR","email":"billing@third.example","id":"CUST-003","name":"Third Customer KG","status":"active"}]
