-- home/.config/invox/template.tex --
Invoice @@INVOICE_NUMBER@@ for @@CUSTOMER_NAME@@
Issued @@ISSUE_DATE@@, due @@DUE_DATE@@
@@LINE_ITEMS_ROWS@@
Subtotal @@SUBTOTAL@@
@@VAT_SUMMARY_ROWS@@
Total @@TOTAL@@
Outstanding @@OUTSTANDING_AMOUNT@@
@@PAYMENT_TERMS_TEXT@@
IBAN @@IBAN@@
-- invoice.yaml --
customer_id: CUST-001
invoice:
  number: CUST-001-001
  issue_date: 2026-03-06
  due_date: 2026-04-05
  status: draft
  period: "Leistungszeitraum: März 2026"
  vat_percent: 20
  paid_amount: 0
positions:
