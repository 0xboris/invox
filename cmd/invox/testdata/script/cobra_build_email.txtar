# build and email parse their flags with pflag, so they report bad flags the
# same way as validate (#47), and send is still an alias of email.

# A misspelt flag after the positional is an unknown flag with a suggestion,
# not an unexpected argument.
exits 2 invox build x.yaml --archiv
! stdout .
cmp stderr want-build-misspelt.txt
exits 2 invox email x.yaml --forse
! stdout .
cmp stderr want-email-misspelt.txt
exits 2 invox send x.yaml --subjct hi
! stdout .
cmp stderr want-send-misspelt.txt

# A dangling flag says which flag needs a value, instead of swallowing the
# invoice.
exits 2 invox build x.yaml -o
! stdout .
cmp stderr want-build-dangling.txt

# A single-dash long flag works and warns. There is no template, so build
# then stops with the usage error for that.
exits 2 invox build -input x.yaml -customers c.yaml -issuer u.yaml
! stdout .
stderr '^warning: -input is deprecated; use --input$'
stderr '^error: template file not found'

-- want-build-misspelt.txt --
error: unknown flag: --archiv; did you mean --archive?
Run 'invox build --help' for usage.
-- want-email-misspelt.txt --
error: unknown flag: --forse; did you mean --force?
Run 'invox email --help' for usage.
-- want-send-misspelt.txt --
error: unknown flag: --subjct; did you mean --subject?
Run 'invox email --help' for usage.
-- want-build-dangling.txt --
error: flag needs an argument: -o
Run 'invox build --help' for usage.
